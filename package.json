{
  "name": "jatiteknologi",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "vp check && astro check && knip",
    "check:fix": "vp check --fix && astro check && knip --fix",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "knip": "knip",
    "test": "vp test",
    "test:e2e": "astro build && playwright test",
    "test:e2e:ui": "astro build && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "void:deploy": "void deploy --platform cloudflare",
    "unlighthouse": "unlighthouse",
    "unlighthouse:ci": "unlighthouse-ci",
    "size": "size-limit",
    "prepare": "vp config && void prepare"
  },
  "dependencies": {
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/sitemap": "^3.7.5",
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/lucide": "^1.2.155",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.102",
    "@oxlint/plugins": "1.93.0",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@unocss/astro": "^66.13.0",
    "@unocss/extractor-mdc": "^66.13.0",
    "@vitest/browser-playwright": "5.1.0",
    "knip": "^6.45.1",
    "playwright": "1.65.1",
    "size-limit": "^14.3.0",
    "typescript": "^6.0.3",
    "unlighthouse": "^0.19.1",
    "unocss": "^66.13.0",
    "vite-plus": "catalog:",
    "void": "^1.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
