{
  "mcpServers": {
    "astro-docs": {
      "type": "http",
      "url": "https://mcp.docs.astro.build/mcp"
    },
    "inspo": {
      "type": "http",
      "url": "https://inspomcp.dev/api/mcp"
    },
    "ui-skills": {
      "type": "http",
      "url": "https://www.ui-skills.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "pnpm",
      "args": ["exec", "playwright", "mcp", "--headless", "--isolated", "--caps=testing"]
    },
    "playwright-test": {
      "type": "stdio",
      "command": "pnpm",
      "args": ["exec", "playwright", "run-test-mcp-server", "--headless"]
    }
  }
}
