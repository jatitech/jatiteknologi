---
import { CONTACT_HREF } from "@/shared/contact";
import { Button } from "@/shared/ui/Button";
import { LanguageSwitch } from "@/shared/ui/LanguageSwitch";
import { Logo } from "@/shared/ui/Logo";
import { dictionaryFor, localizedPath, platformLinks, type Locale } from "@/shared/i18n";

interface Props {
	locale: Locale;
	/** This page's path in each locale where it exists, as passed to `BaseLayout`. */
	alternates: Partial<Record<Locale, string>>;
	/** Links shown between the logo and the desktop controls, as passed to `BaseLayout`. */
	links?: ReadonlyArray<{ href: string; label: string }>;
}

const { locale, alternates, links = [] } = Astro.props;
const strings = dictionaryFor(locale);
const home = localizedPath(locale, "home");

/** The six platform pages, shown under "Integrasi". */
const integrations = platformLinks(locale);

/** The mobile menu is a native popover, so it opens and closes without a script. */
const MENU_ID = "mobile-menu";

const ICON_TARGET =
	"inline-flex size-11 shrink-0 items-center justify-center rounded-full text-on-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
---

<header
	class="sticky top-0 z-40 px-5 pt-[calc(env(safe-area-inset-top)+12px)] md:px-8 lg:px-12"
>
	<nav
		aria-label={strings.nav.label}
		class="mx-auto flex h-14 w-full max-w-[1344px] items-center justify-between rounded-full bg-surface py-1.5 pr-1.5 pl-5 supports-[backdrop-filter]:bg-surface/72 supports-[backdrop-filter]:backdrop-blur-[14px] lg:h-16 lg:py-2.5 lg:pr-3.5"
	>
		<a
			href={home}
			class="rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
		>
			<Logo locale={locale} />
		</a>

		<ul role="list" class="hidden items-center gap-2 lg:flex">
			<li class="relative">
				<details class="group">
					<summary
						class="inline-flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-full px-3 text-label-sm font-medium text-on-surface hover:bg-surface-sunken focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden"
					>
						{strings.nav.integrations}
						<span class="i-ph-caret-down size-3.5 group-open:rotate-180" aria-hidden="true"></span>
					</summary>
					<ul
						role="list"
						class="absolute top-full left-0 z-50 mt-2 flex w-64 flex-col gap-1 rounded-lg border border-outline bg-surface p-2 shadow-overlay"
					>
						{
							integrations.map((integration) => (
								<li>
									<a
									href={integration.href}
									translate="no"
									class="flex min-h-11 items-center rounded-md px-3 text-label-md font-medium text-on-surface hover:bg-surface-sunken focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
								>
									{integration.label}
								</a>
							</li>
							))
						}
					</ul>
				</details>
			</li>
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class="inline-flex h-9 items-center rounded-full px-3 text-label-sm font-medium text-on-surface hover:bg-surface-sunken focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="hidden items-center gap-3 lg:flex">
			<LanguageSwitch locale={locale} alternates={alternates} />
			<Button href={CONTACT_HREF}>{strings.nav.primaryAction}</Button>
		</div>

		<div class="flex items-center gap-2 lg:hidden">
			<button
				type="button"
				popovertarget={MENU_ID}
				aria-label={strings.nav.menu}
				class={ICON_TARGET}
			>
				<span class="i-ph-list size-[18px]" aria-hidden="true"></span>
			</button>
			<a
				href={CONTACT_HREF}
				aria-label={strings.nav.primaryAction}
				class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				<span class="i-ph-arrow-right size-5" aria-hidden="true"></span>
			</a>
		</div>
	</nav>

	<div
		id={MENU_ID}
		popover="auto"
		role="dialog"
		aria-label={strings.nav.menu}
		class="m-0 size-full max-h-none max-w-none border-0 bg-neutral p-0 text-on-surface shadow-overlay"
	>
		<div
			class="flex min-h-dvh flex-col gap-8 px-5 pt-[calc(env(safe-area-inset-top)+12px)] pb-[calc(env(safe-area-inset-bottom)+24px)]"
		>
			<div class="flex h-14 items-center justify-between">
				<a
					href={home}
					class="rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
				>
					<Logo locale={locale} />
				</a>
				<button
					type="button"
					popovertarget={MENU_ID}
					popovertargetaction="hide"
					autofocus
					aria-label={strings.nav.close}
					class={ICON_TARGET}
				>
					<span class="i-ph-x size-5" aria-hidden="true"></span>
				</button>
			</div>

			<div class="flex flex-col items-start gap-6">
				<LanguageSwitch locale={locale} alternates={alternates} />
				<Button href={CONTACT_HREF} class="w-full justify-between">
					{strings.nav.primaryAction}
				</Button>
			</div>
		</div>
	</div>
</header>
