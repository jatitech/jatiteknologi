---
import logo from "../../../../brand/logo/jatiteknologi-horizontal.svg";

import { dictionaryFor } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n";

interface Props {
	locale: Locale;
}

/**
 * The horizontal lockup, which carries the name, so its alt text is the brand name. The full-colour
 * master from `brand/logo`, the one source of the logo, sits on the light ground.
 */
const { locale } = Astro.props;
---

<img src={logo.src} alt={dictionaryFor(locale).meta.siteTitle} width="160" height="28" />
