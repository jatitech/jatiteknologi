---
interface Props {
	/**
	 * `primary` is the filled pill with the arrow chip, `secondary` is the outlined pill, and `text`
	 * is a bare link with a trailing arrow.
	 */
	variant?: "primary" | "secondary" | "text";
	/** Renders an `<a>` when set, otherwise a `<button type="button">`. */
	href?: string;
	class?: string;
}

const { variant = "primary", href, class: className } = Astro.props;

const FOCUS =
	"focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary focus-visible:ring-4 focus-visible:ring-secondary/35";

const CLASSES = {
	primary: `group inline-flex h-12 items-center gap-3 rounded-full bg-primary py-2 pr-2 pl-[22px] text-label-md font-semibold text-on-primary hover:bg-primary-hover active:scale-[0.98] ${FOCUS}`,
	secondary: `inline-flex h-12 items-center gap-2 rounded-full border border-outline-strong bg-surface px-[22px] text-label-md font-semibold text-on-surface hover:bg-surface-sunken ${FOCUS}`,
	text: `group inline-flex min-h-11 items-center gap-1.5 rounded-full text-label-sm font-medium text-on-surface underline-offset-4 hover:underline ${FOCUS}`,
} as const;

const Tag = href === undefined ? "button" : "a";
---

<Tag
	href={href}
	type={href === undefined ? "button" : undefined}
	class:list={[
		CLASSES[variant],
		"transition-[background-color,transform] duration-150 ease-out motion-reduce:transition-none",
		className,
	]}
>
	<slot />
	{
		variant === "primary" && (
			<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-surface text-primary">
				<span
					class="i-ph-arrow-right size-2.5 motion-safe:transition-transform motion-safe:duration-150 motion-safe:group-hover:translate-x-0.5"
					aria-hidden="true"
				/>
			</span>
		)
	}
	{
		variant === "text" && (
			<span
				class="i-ph-arrow-right size-4 motion-safe:transition-transform motion-safe:duration-150 motion-safe:group-hover:translate-x-0.5"
				aria-hidden="true"
			/>
		)
	}
</Tag>
