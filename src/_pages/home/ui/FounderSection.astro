---
import { PERSONAL_SITE_HREF } from "@/shared/contact";
import { dictionaryFor } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n";
import { Eyebrow } from "@/shared/ui/Eyebrow";

import FounderPhoto from "./FounderPhoto.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const strings = dictionaryFor(locale).home.founder;
---

<section
	aria-labelledby="founder-heading"
	class="scroll-mt-24 px-margin-mobile py-section-mobile md:px-margin-tablet lg:px-margin lg:py-section"
>
	<div class="mx-auto flex w-full max-w-[1280px] flex-col gap-4 lg:flex-row lg:items-start lg:gap-20">
		<FounderPhoto locale={locale} />
		<div class="flex flex-col gap-4 lg:max-w-[640px]">
			<Eyebrow>{strings.eyebrow}</Eyebrow>
			<h2
				id="founder-heading"
				class="text-mobile-headline-sm font-semibold text-on-surface lg:text-headline-sm"
			>
				{strings.name}
			</h2>
			<p class="text-mobile-body-lg text-on-surface-variant lg:text-body-lg">{strings.bio}</p>
			<p class="text-body-sm text-muted">{strings.disclosure}</p>
			<a
				href={PERSONAL_SITE_HREF}
				target="_blank"
				rel="noopener"
				class="inline-flex min-h-11 items-center gap-1.5 self-start text-label-md font-medium text-on-surface underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				{strings.personalSite}
				<span class="sr-only">{strings.newTab}</span>
				<span class="i-ph-arrow-up-right size-4 text-primary" aria-hidden="true"></span>
			</a>
		</div>
	</div>
</section>
