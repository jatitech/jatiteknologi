---
import type { FeatureIcon } from "./feature";

interface Props {
	icon: FeatureIcon;
	title: string;
	description: string;
}

const { icon, title, description } = Astro.props;

/** Literal class names, so UnoCSS can see them in this file. */
const ICONS = {
	stock: "i-ph-stack",
	data: "i-ph-key",
	phased: "i-ph-steps",
	apps: "i-ph-app-window",
	integration: "i-ph-plugs-connected",
	docs: "i-ph-book-open-text",
	monitoring: "i-ph-wrench",
	adjustments: "i-ph-sliders-horizontal",
	engineer: "i-ph-user-circle",
} as const satisfies Record<FeatureIcon, string>;
---

<li class="flex items-start gap-4 border-b border-outline py-4">
	<span
		class="flex size-10 shrink-0 items-center justify-center rounded-sm bg-primary-container text-primary"
	>
		<span class:list={[ICONS[icon], "size-5"]} aria-hidden="true"></span>
	</span>
	<div class="flex min-w-0 flex-col gap-1">
		<h3 class="text-title-md font-semibold text-on-surface">{title}</h3>
		<p class="text-body-sm text-on-surface-variant">{description}</p>
	</div>
</li>
