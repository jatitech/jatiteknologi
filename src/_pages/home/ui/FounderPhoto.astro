---
import photo from "../../../assets/founder.webp";

import { dictionaryFor } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n";

interface Props {
	locale: Locale;
}

/**
 * The founder's portrait, cropped to 5:6 from the original studio photo (800 × 960, shown at up to
 * 400 px wide), so the frame needs no cropping of its own. It sits below the fold, so it loads lazily.
 */
const { locale } = Astro.props;
---

<div
	class="aspect-[8/9] w-full max-w-[320px] shrink-0 overflow-hidden rounded-lg bg-surface-sunken lg:aspect-[5/6] lg:max-w-[400px]"
>
	<img
		src={photo.src}
		alt={dictionaryFor(locale).home.founder.photoAlt}
		width="400"
		height="480"
		loading="lazy"
		decoding="async"
		class="size-full object-cover object-top"
	/>
</div>
