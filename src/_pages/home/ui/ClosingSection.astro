---
import { dictionaryFor, type Locale } from "@/shared/i18n";
import { ContactActions } from "@/shared/ui/ContactActions";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dictionary = dictionaryFor(locale);
const strings = dictionary.home.closing;
---

<section
	aria-labelledby="closing-heading"
	class="relative isolate overflow-hidden px-margin-mobile py-section-tablet md:px-margin-tablet lg:px-margin lg:py-40"
>
	<div
		aria-hidden="true"
		class="absolute top-1/2 left-1/2 -z-10 h-[300px] w-[360px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-secondary/40 blur-3xl md:h-[420px] md:w-[720px]"
	></div>
	<div class="relative mx-auto flex w-full max-w-[1280px] flex-col items-center gap-6 text-center lg:gap-8">
		<h2
			id="closing-heading"
			class="max-w-[760px] text-mobile-display-lg font-medium text-balance text-on-surface lg:text-display-lg"
		>
			{strings.headline}
		</h2>
		<ContactActions
			primaryLabel={dictionary.nav.primaryAction}
			secondaryLabel={dictionary.home.actions.email}
		/>
	</div>
</section>
