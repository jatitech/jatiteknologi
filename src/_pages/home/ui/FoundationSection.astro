---
import { dictionaryFor, localizedPath, PLATFORM_SLUGS, platformCopyFor } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n";
import { Eyebrow } from "@/shared/ui/Eyebrow";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const strings = dictionaryFor(locale).home.foundation;

// Class names are written out in full so UnoCSS finds them. The logos are the monochrome marks from
// Simple Icons, drawn in the text colour, and the name beside them stays as text.
const LOGOS: Record<(typeof PLATFORM_SLUGS)[number], ReadonlyArray<string>> = {
	"frappe-erpnext": ["i-simple-icons-frappe", "i-simple-icons-erpnext"],
	odoo: ["i-simple-icons-odoo"],
	meta: ["i-simple-icons-meta"],
	shopify: ["i-simple-icons-shopify"],
	shopee: ["i-simple-icons-shopee"],
	"tiktok-shop": ["i-simple-icons-tiktok"],
};
---

<section
	aria-labelledby="foundation-heading"
	class="scroll-mt-24 px-margin-mobile py-8 md:px-margin-tablet lg:px-margin lg:py-12"
>
	<div
		class="mx-auto flex w-full max-w-[1280px] flex-col gap-5 rounded-lg border border-outline bg-surface px-5 py-6 lg:gap-8 lg:p-12"
	>
		<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
			<div class="flex flex-col gap-3 lg:max-w-[600px]">
				<Eyebrow>{strings.eyebrow}</Eyebrow>
				<h2
					id="foundation-heading"
					class="text-mobile-headline-md font-medium text-balance text-on-surface md:text-headline-md"
				>
					{strings.headline}
				</h2>
			</div>
			<ul role="list" class="flex flex-col gap-3 lg:w-[536px] lg:shrink-0 lg:gap-4">
				<li class="flex items-start gap-2.5 lg:gap-3">
					<span
						class="i-ph-check-circle size-5 shrink-0 text-primary lg:size-6"
						aria-hidden="true"
					></span>
					<span class="text-mobile-body-md text-on-surface-variant lg:text-body-md">
						{strings.checkIntegrations}
					</span>
				</li>
				<li class="flex items-start gap-2.5 lg:gap-3">
					<span
						class="i-ph-check-circle size-5 shrink-0 text-primary lg:size-6"
						aria-hidden="true"
					></span>
					<span class="text-mobile-body-md text-on-surface-variant lg:text-body-md">
						{strings.checkIndependent}
					</span>
				</li>
			</ul>
		</div>
		<div aria-hidden="true" class="h-px bg-outline"></div>
		<ul role="list" class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6 lg:gap-4">
			{
				PLATFORM_SLUGS.map((slug) => (
					<li>
						<a
							href={localizedPath(locale, slug)}
							class="group relative flex min-h-28 flex-col items-center justify-center gap-3 rounded-md bg-surface-sunken p-3 text-center text-label-md font-semibold text-on-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary lg:min-h-37 lg:p-6"
							aria-label={`${platformCopyFor(locale, slug).name}: ${strings.pageLabel}`}
						>
							<span aria-hidden="true" class="flex items-center gap-2 text-on-surface-variant">
								{LOGOS[slug].map((logo) => (
									<span class={`${logo} size-7 lg:size-8`} />
								))}
							</span>
							<span translate="no">{platformCopyFor(locale, slug).name}</span>
							<span
								aria-hidden="true"
								class="absolute top-3 right-3 hidden size-6 items-center justify-center rounded-full bg-surface group-hover:flex group-focus-visible:flex"
							>
								<span class="i-ph-arrow-up-right size-3.5"></span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<p class="text-body-sm text-muted">{strings.trademark}</p>
	</div>
</section>
