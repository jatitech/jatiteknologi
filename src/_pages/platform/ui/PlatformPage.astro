---
import {
	dictionaryFor,
	localizedPath,
	platformCopyFor,
	type Locale,
	type PlatformPageSlug,
} from "@/shared/i18n";
import { breadcrumbJsonLd, serializeJsonLd } from "@/shared/seo";

import PlatformBuilds from "./PlatformBuilds.astro";
import PlatformClosing from "./PlatformClosing.astro";
import PlatformExperience from "./PlatformExperience.astro";
import PlatformExtra from "./PlatformExtra.astro";
import PlatformFlow from "./PlatformFlow.astro";
import PlatformHero from "./PlatformHero.astro";
import PlatformLimits from "./PlatformLimits.astro";
import PlatformProblems from "./PlatformProblems.astro";
import PlatformTerms from "./PlatformTerms.astro";

interface Props {
	locale: Locale;
	slug: PlatformPageSlug;
}

const { locale, slug } = Astro.props;
const copy = platformCopyFor(locale, slug);
const shared = dictionaryFor(locale).platform.shared;

/** Home, then the page. There is no integrations index yet, so "Integrasi" is left out rather than linked. */
const breadcrumb = serializeJsonLd(
	breadcrumbJsonLd([
		{ name: shared.breadcrumb.home, url: new URL(localizedPath(locale, "home"), Astro.site).href },
		{ name: copy.name, url: new URL(localizedPath(locale, slug), Astro.site).href },
	]),
);
---

<PlatformHero locale={locale} slug={slug} copy={copy} />
<PlatformProblems locale={locale} copy={copy} />
<PlatformBuilds locale={locale} copy={copy} />
{copy.extra && <PlatformExtra locale={locale} extra={copy.extra} />}
<PlatformFlow locale={locale} copy={copy} />
<PlatformLimits copy={copy} />
<PlatformExperience locale={locale} copy={copy} />
<PlatformTerms locale={locale} />
<PlatformClosing locale={locale} />
<script type="application/ld+json" is:inline set:html={breadcrumb}></script>
