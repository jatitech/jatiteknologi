---
import { Button } from "@/shared/ui/Button";
import { Eyebrow } from "@/shared/ui/Eyebrow";
import { dictionaryFor, localizedPath } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const strings = dictionaryFor(locale);
---

<section
	class="mx-auto flex min-h-[60svh] w-full max-w-[1280px] flex-col justify-center gap-6 px-5 py-section-mobile md:px-8 md:py-section-tablet lg:px-12"
>
	<Eyebrow>{strings.notFound.eyebrow}</Eyebrow>
	<h1
		class="text-mobile-display-lg font-medium text-balance text-on-surface md:text-display-lg"
	>
		{strings.notFound.headline}
	</h1>
	<p class="max-w-[52ch] text-mobile-body-lg text-on-surface-variant md:text-body-lg">
		{strings.notFound.lead}
	</p>
	<div class="pt-2">
		<Button href={localizedPath(locale, "home")}>{strings.notFound.home}</Button>
	</div>
</section>
